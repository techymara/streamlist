# Copy this file to .env (for running the app locally) and fill in your own
# values. The SAME values also need to go into your GitHub repo's secrets
# (Settings → Secrets and variables → Actions) so the weekly email can send
# on its own schedule — see README.md.

# Required — free key from https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Region for streaming availability (ISO 3166-1 country code)
STREAMING_REGION=US

# Required — from your Supabase project: Settings → API
#   SUPABASE_URL is the "Project URL"
#   SUPABASE_SERVICE_ROLE_KEY is the "service_role" secret key (NOT the anon/public key —
#   the service role key can bypass row-level security, so never put it in frontend code;
#   it's only ever used here, server-side)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Required for the weekly email — free key from https://resend.com/api-keys
RESEND_API_KEY=
# Where the digest gets sent. Without a verified custom domain in Resend,
# the default sender can only deliver to the email address on your own
# Resend account — which is normally exactly this address anyway.
DIGEST_TO_EMAIL=you@example.com
# Optional — only change this if you've verified your own domain in Resend
DIGEST_FROM_EMAIL=Streamlist <onboarding@resend.dev>

PORT=3000
